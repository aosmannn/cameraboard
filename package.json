{
  "name": "wayframe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "db:push": "npx --yes supabase@latest db push",
    "db:schema": "cat supabase/migrations/*.sql > supabase/schema.sql"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.6",
    "@types/topojson-client": "^3.1.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/analytics": "^2.0.1",
    "exifr": "^7.1.3",
    "gifenc": "^1.0.3",
    "leaflet": "1.9",
    "qrcode": "^1.5.4",
    "satori": "^0.36.0",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "world-atlas": "^2.0.2"
  }
}
